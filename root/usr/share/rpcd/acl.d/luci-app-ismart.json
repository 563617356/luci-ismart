{
	"luci-app-ismart": {
		"description": "Grant access to bypass-router mode switching (services/ismart)",
		"read": {
			"uci": [ "ismart" ],
			"file": {
				"/usr/bin/ismart-ctl": [ "exec" ],
				"/usr/libexec/ismart/core.sh": [ "read" ],
				"/etc/ismart/backup/*": [ "read" ]
			}
		},
		"write": {
			"uci": [ "ismart" ],
			"file": {
				"/usr/bin/ismart-ctl": [ "exec" ],
				"/usr/libexec/ismart/*": [ "read" ],
				"/etc/ismart/backup/*": [ "write" ]
			}
		}
	}
}
