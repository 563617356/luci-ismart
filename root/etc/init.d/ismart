#!/bin/sh /etc/rc.common
# luci-ismart 防回滚守护
#
# 旁路由切换会改本机 IP。如果改完网口起不来（IP 被占用、掩码写错、
# 网线插错口），设备就失联了，只能靠串口或 reset 救砖。
#
# 这里在后台盯一段时间：拿到预期 IP 就解除观察；超时仍未生效
# 就用备份自动切回路由模式。观察期间用户手工改回来了同样算成功。
#
# 循环写在独立脚本里而不是内联 -c 字符串：
# 内联写法一旦引号被 rpcd 吃掉就是一段诡异的死循环，很难排查。

USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance guard
	procd_set_param command /usr/libexec/ismart/guard-loop.sh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 停守护的同时清掉待观察标记，否则守护会被 respawn 拉起来空转
	rm -f /var/run/ismart/pending
}

service_triggers() {
	procd_add_reload_trigger "ismart"
}
